digraph ER {
  rankdir=LR; nodesep=0.35; ranksep=0.9; fontname="Helvetica";
  node [shape=plain fontname="Helvetica" fontsize=10];
  edge [dir=both arrowtail=tee arrowhead=crow color="#444444"];
  node [ ];
  parking_lot [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#1f4e79"><font color="white"><b>parking_lot</b></font></td></tr><tr><td align="left"><b>PK</b> lot_id</td></tr><tr><td align="left"><b>UK</b> lot_code</td></tr><tr><td align="left"><b>FK</b> parent_lot_id</td></tr><tr><td align="left">display_name, capacity, address</td></tr><tr><td align="left">latitude, longitude, time_zone</td></tr><tr><td align="left">is_active, created_at, updated_at</td></tr></table>>];
  occupancy_reading [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#1f4e79"><font color="white"><b>occupancy_reading</b></font></td></tr><tr><td align="left"><b>PK</b> reading_id</td></tr><tr><td align="left"><b>FK,UK</b> lot_id, <b>UK</b> recorded_at</td></tr><tr><td align="left">occupied_count, source, ingested_at</td></tr></table>>];
  lot_hours [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#1f4e79"><font color="white"><b>lot_hours</b></font></td></tr><tr><td align="left"><b>PK</b> lot_hours_id, <b>FK</b> lot_id</td></tr><tr><td align="left">day_of_week, open_time, close_time</td></tr><tr><td align="left">effective_from, effective_to</td></tr></table>>];
  lot_special_hours [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#2e7d32"><font color="white"><b>lot_special_hours (v2)</b></font></td></tr><tr><td align="left"><b>PK</b> lot_special_hours_id</td></tr><tr><td align="left"><b>FK</b> lot_id, <b>FK</b> holiday_id</td></tr><tr><td align="left">special_date, is_closed</td></tr><tr><td align="left">open_time, close_time, note</td></tr></table>>];
  holiday [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#2e7d32"><font color="white"><b>holiday (v2)</b></font></td></tr><tr><td align="left"><b>PK</b> holiday_id</td></tr><tr><td align="left">holiday_date, name</td></tr></table>>];
  lot_closure [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#1f4e79"><font color="white"><b>lot_closure</b></font></td></tr><tr><td align="left"><b>PK</b> closure_id, <b>FK</b> lot_id</td></tr><tr><td align="left"><b>FK</b> closure_reason_id (v2)</td></tr><tr><td align="left">starts_at, ends_at, closure_type</td></tr><tr><td align="left">spaces_closed, reason</td></tr></table>>];
  closure_reason [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#2e7d32"><font color="white"><b>closure_reason (v2)</b></font></td></tr><tr><td align="left"><b>PK</b> closure_reason_id</td></tr><tr><td align="left"><b>UK</b> code, name</td></tr></table>>];
  rate_plan [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#1f4e79"><font color="white"><b>rate_plan</b></font></td></tr><tr><td align="left"><b>PK</b> rate_plan_id, <b>FK</b> lot_id</td></tr><tr><td align="left">plan_name, day_of_week, start/end_time</td></tr><tr><td align="left">rate_amount, rate_unit, free_minutes</td></tr><tr><td align="left">max_daily, currency, effective dates</td></tr></table>>];
  lot_requirement [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#1f4e79"><font color="white"><b>lot_requirement</b></font></td></tr><tr><td align="left"><b>PK</b> lot_requirement_id</td></tr><tr><td align="left"><b>FK</b> lot_id, <b>FK</b> requirement_type_id</td></tr><tr><td align="left">spaces_count, applies_from/to</td></tr><tr><td align="left">effective_from, effective_to</td></tr></table>>];
  requirement_type [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="2"><tr><td bgcolor="#1f4e79"><font color="white"><b>requirement_type</b></font></td></tr><tr><td align="left"><b>PK</b> requirement_type_id</td></tr><tr><td align="left"><b>UK</b> code, name, description</td></tr></table>>];
  parking_lot -> occupancy_reading; parking_lot -> lot_hours; parking_lot -> lot_special_hours;
  holiday -> lot_special_hours [arrowtail=teeodot];
  parking_lot -> lot_closure; closure_reason -> lot_closure [arrowtail=teeodot];
  parking_lot -> rate_plan; parking_lot -> lot_requirement; requirement_type -> lot_requirement;
  parking_lot -> parking_lot [label=" section of" fontsize=9 arrowtail=teeodot];
}
